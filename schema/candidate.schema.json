{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YellankiKaushik/AI-Free-Tier-Tracker/schema/candidate.schema.json",
  "title": "AI Free Tier Tracker unverified candidate",
  "type": "object",
  "required": ["tool", "assessment", "confidence", "changes", "source", "_meta"],
  "properties": {
    "tool": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "assessment": {
      "enum": ["no_change", "possible_change", "uncertain"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "old", "new", "evidence"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "old": {},
          "new": {},
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "required": ["url", "page_sha256"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "page_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "_meta": {
      "type": "object",
      "required": ["verified", "page_sha256", "model", "generated_at"],
      "properties": {
        "verified": { "const": false },
        "page_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
