{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YellankiKaushik/AI-Free-Tier-Tracker/schema/tool.schema.json",
  "title": "AI Free Tier Tracker tool record",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "slug",
    "vendor",
    "category",
    "product_url",
    "status",
    "platforms",
    "authentication",
    "free_tier",
    "models",
    "trial",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "vendor": { "type": "string", "minLength": 1 },
    "category": {
      "enum": [
        "coding-assistant",
        "agentic-ide",
        "coding-agent",
        "cli-agent",
        "app-builder",
        "cloud-ide",
        "open-source-agent",
        "model-api"
      ]
    },
    "product_url": { "type": "string", "format": "uri" },
    "pricing_url": { "type": ["string", "null"], "format": "uri" },
    "repo_url": { "type": ["string", "null"], "format": "uri" },
    "status": {
      "type": "object",
      "required": ["availability"],
      "properties": {
        "availability": {
          "enum": ["active", "legacy", "discontinued", "restricted-new-signups"]
        },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "vscode",
          "jetbrains",
          "visual-studio",
          "cli",
          "web",
          "desktop",
          "browser",
          "api",
          "github",
          "self-hosted",
          "cloud",
          "local"
        ]
      },
      "uniqueItems": true
    },
    "authentication": {
      "type": "object",
      "required": ["account_required", "credit_card_required"],
      "properties": {
        "account_required": { "$ref": "#/$defs/yesNoUnknown" },
        "credit_card_required": { "$ref": "#/$defs/yesNoUnknown" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "free_tier": {
      "type": "object",
      "required": [
        "available",
        "types",
        "plan_name",
        "quantity_published",
        "quota_pools",
        "after_exhaustion"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "types": {
          "type": "array",
          "items": {
            "enum": [
              "recurring_daily",
              "recurring_weekly",
              "recurring_monthly",
              "dynamic_rate_limit",
              "one_time_signup",
              "time_limited_trial",
              "student",
              "open_source_byok",
              "promotional",
              "legacy",
              "discontinued"
            ]
          },
          "uniqueItems": true
        },
        "plan_name": { "type": ["string", "null"] },
        "quantity_published": { "type": "boolean" },
        "quota_pools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "amount", "unit", "period", "reset"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "name": { "type": "string", "minLength": 1 },
              "amount": { "type": ["number", "integer", "string", "null"] },
              "unit": { "type": "string", "minLength": 1 },
              "period": {
                "enum": [
                  "day",
                  "week",
                  "month",
                  "billing_cycle",
                  "dynamic",
                  "one_time",
                  "provider_specific",
                  "not_applicable"
                ]
              },
              "cap": { "type": ["number", "integer", "string", "null"] },
              "reset": {
                "type": "object",
                "required": ["period"],
                "properties": {
                  "period": {
                    "enum": [
                      "daily",
                      "weekly",
                      "monthly",
                      "billing_cycle",
                      "dynamic",
                      "provider_specific",
                      "not_applicable",
                      "undisclosed"
                    ]
                  },
                  "time": { "type": ["string", "null"] },
                  "timezone": { "type": ["string", "null"] },
                  "notes": { "type": ["string", "null"] }
                },
                "additionalProperties": false
              },
              "rollover": {
                "enum": ["yes", "no", "partial", "unknown", "not_applicable"]
              },
              "notes": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "after_exhaustion": { "type": "string" },
        "rollover": {
          "enum": ["yes", "no", "partial", "unknown", "not_applicable"]
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "required": ["available", "restrictions"],
      "properties": {
        "available": { "type": "array", "items": { "type": "string" } },
        "restrictions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "project_limits": { "type": "array", "items": { "type": "string" } },
    "deployment": { "type": "array", "items": { "type": "string" } },
    "runtime_limits": { "type": "array", "items": { "type": "string" } },
    "storage_limits": { "type": "array", "items": { "type": "string" } },
    "concurrency_limits": { "type": "array", "items": { "type": "string" } },
    "eligibility": { "type": "array", "items": { "type": "string" } },
    "regions": { "type": "array", "items": { "type": "string" } },
    "trial": {
      "type": "object",
      "required": ["available", "recurring"],
      "properties": {
        "available": { "type": "boolean" },
        "duration_days": { "type": ["number", "integer", "null"] },
        "allowance": { "type": ["string", "null"] },
        "recurring": { "type": "boolean" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "verification": {
      "type": "object",
      "required": ["last_verified", "confidence", "confidence_score", "sources"],
      "properties": {
        "last_verified": { "type": "string", "format": "date" },
        "confidence": {
          "enum": [
            "official_exact",
            "official_undisclosed",
            "mixed",
            "community_only",
            "needs_verification"
          ]
        },
        "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url", "type", "supports"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "type": {
                "enum": [
                  "official_pricing",
                  "official_docs",
                  "official_help",
                  "official_blog",
                  "official_repo",
                  "official_changelog",
                  "secondary",
                  "community"
                ]
              },
              "retrieved_at": { "type": ["string", "null"] },
              "supports_fields": { "type": "array", "items": { "type": "string" } },
              "supports": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "page_sha256": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "yesNoUnknown": {
      "enum": ["yes", "no", "unknown", "not_applicable"]
    }
  }
}
